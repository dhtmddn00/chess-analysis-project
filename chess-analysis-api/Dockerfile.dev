# Development Dockerfile for Spring Boot API
FROM openjdk:21-jdk-slim

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy gradle wrapper and dependencies
COPY gradlew ./
COPY gradle gradle/
COPY build.gradle settings.gradle ./

# Make gradlew executable
RUN chmod +x ./gradlew

# Download dependencies (caching layer)
RUN ./gradlew dependencies --no-daemon

# Copy source code
COPY src src/

# Expose ports (8080 for app, 5005 for debug)
EXPOSE 8080 5005

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/actuator/health || exit 1

# Run with Spring Boot DevTools for hot reload
CMD ["./gradlew", "bootRun", "--no-daemon", "-Dspring.profiles.active=dev"]