# Development Dockerfile for Spring Boot API
FROM gradle:8.5-jdk21-jammy

USER root
# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Gradle project files
COPY build.gradle settings.gradle ./

# Download dependencies (caching layer)
RUN gradle dependencies --no-daemon

# Copy source code
COPY src src/

# Expose ports (8080 for app, 5005 for debug)
EXPOSE 8080 5005

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/actuator/health || exit 1

# Run with Spring Boot DevTools for hot reload
CMD ["gradle", "clean", "bootRun", "--no-daemon", "-Dspring.profiles.active=dev"]
